---
import { thumb } from '../lib/inhalte';
import type { saisons } from '../lib/inhalte';

interface Props {
  saisons: Awaited<ReturnType<typeof saisons>>;
}
const { saisons: liste } = Astro.props;
---

<ul class="saisonwand">
  {
    liste.map((s) => (
      <li class:list={['saison', { 'saison--leer': !s.titelbild }]}>
        <a href={`/spieltagsbilder/${s.slug}/`}>
          {s.titelbild ? (
            <img src={thumb(s.titelbild)} alt="" loading="lazy" decoding="async" width="720" height="480" />
          ) : (
            <img src="/images/kurve/rauch-lila.webp" alt="" loading="lazy" decoding="async" width="1920" height="1080" />
          )}
          <span class="saison__name">
            <span class="visually-hidden">Saison </span>
            {s.saison}
          </span>
          <span class="saison__zahl">{s.titelbild ? `${s.galerien.length} Galerien · ${s.bilder} Bilder` : 'Bilder folgen'}</span>
        </a>
      </li>
    ))
  }
</ul>

<style>
  .saisonwand {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 15rem), 1fr));
    gap: clamp(0.5rem, 1.2vw, 1rem);
  }
  .saison:nth-child(-n + 2) {
    grid-column: span 2;
  }
  .saison {
    container-type: inline-size;
  }
  .saison a {
    position: relative;
    display: grid;
    align-content: end;
    min-height: clamp(11rem, 18vw, 15rem);
    height: 100%;
    padding: 1rem 1.1rem 0.9rem;
    overflow: hidden;
    isolation: isolate;
    background: var(--lila-tief);
    color: var(--weiss);
    text-decoration: none;
  }
  .saison img {
    position: absolute;
    inset: 0;
    z-index: -2;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(1) contrast(1.1);
    transition:
      filter 0.6s var(--ease-out),
      transform 0.9s var(--ease-out);
  }
  .saison a::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(to top, rgb(42 10 53 / 0.95), rgb(92 29 104 / 0.55));
    mix-blend-mode: multiply;
    transition: opacity 0.6s var(--ease-out);
  }
  .saison a:hover img,
  .saison a:focus-visible img {
    filter: grayscale(0) contrast(1.05);
    transform: scale(1.05);
  }
  .saison a:hover::before {
    opacity: 0.55;
  }
  .saison__name {
    font-family: var(--display);
    font-size: clamp(2rem, 19cqi, 4.6rem);
    line-height: 0.9;
  }
  .saison__zahl {
    font-size: 0.9rem;
    color: #ecdcf2;
  }
  .saison--leer img {
    filter: none;
  }
  .saison--leer .saison__zahl {
    display: inline-block;
    justify-self: start;
    margin-top: 0.4rem;
    padding: 0.2rem 0.6rem;
    background: var(--weiss);
    color: var(--lila);
    font-family: var(--display);
    text-transform: uppercase;
    font-size: 1rem;
    transform: rotate(-2deg);
  }

  @media (max-width: 640px) {
    .saisonwand {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .saison a {
      min-height: 8.5rem;
      padding: 0.7rem 0.75rem 0.6rem;
    }
    .saison__zahl {
      font-size: 0.78rem;
    }
  }
</style>
