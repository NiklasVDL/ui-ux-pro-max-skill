---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Rad from '../components/Rad.astro';
import Laufband from '../components/Laufband.astro';
import VideoEmbed from '../components/VideoEmbed.astro';
import SaisonWand from '../components/SaisonWand.astro';
import {
  aktuelles,
  datum,
  einstellungen,
  galerieUrl,
  letzterSpieltag,
  saisonLang,
  saisons,
  seiten,
  termin,
  thumb,
  trailer,
} from '../lib/inhalte';
import links from '../data/links.json';

const letzter = await letzterSpieltag();
const beitraege = (await aktuelles()).slice(0, 3);
const saisonListe = await saisons();
const alleSeiten = await seiten();
const seite = (id: string) => alleSeiten.find((s) => s.id === id)!;
const werWirSind = seite('wer-wir-sind');
const logos = seite('gruppenlogos');
const stationen = ['5-jahre', '10-jahre', '15-jahre', '20-jahre'].map(seite);
const videos = await trailer();
const kontakt = seite('kontakt');

const galerienGesamt = saisonListe.reduce((n, s) => n + s.galerien.length, 0);
const bilderGesamt = saisonListe.reduce((n, s) => n + s.bilder, 0);
const zahl = new Intl.NumberFormat('de-DE');

/** Erster Satz bzw. die ersten Sätze eines wortgetreuen Textes, ohne ihn umzuschreiben. */
const anriss = (text: string, mindestens = 140) => {
  const teile = text.match(/[^.!?]+[.!?]+["“]?(?=\s|$)\s*/g) ?? [text];
  let aus = '';
  for (const t of teile) {
    aus += t;
    if (aus.length >= mindestens) break;
  }
  return aus.trim();
};
const vorschau = (text: string) => text.replace(/\s+/g, ' ').replace(/[*_#>]/g, '').trim();

const heroVideo = einstellungen.heroVideo as { anbieter: string; videoId: string; titel: string; datei?: string };
const heroDatei = heroVideo.anbieter === 'datei' && heroVideo.datei ? heroVideo.datei : undefined;
const heroSrc =
  heroVideo.anbieter === 'youtube'
    ? `https://www.youtube-nocookie.com/embed/${heroVideo.videoId}?autoplay=1&mute=1&controls=0&loop=1&playlist=${heroVideo.videoId}&playsinline=1&rel=0&modestbranding=1`
    : `https://player.vimeo.com/video/${heroVideo.videoId}?background=1&dnt=1&quality=720p`;
const trailerSrc = heroDatei
  ? heroDatei
  : heroVideo.anbieter === 'youtube'
    ? `https://www.youtube-nocookie.com/embed/${heroVideo.videoId}?autoplay=1&rel=0`
    : `https://player.vimeo.com/video/${heroVideo.videoId}?autoplay=1&dnt=1&title=0&byline=0&portrait=0&color=883893`;
---

<Base kopf="hero">
  <!-- ============ Trailer im Hintergrund ============ -->
  <section class="hero" aria-labelledby="hero-titel">
    <div class="hero__medien" aria-hidden="true">
      <img class="hero__poster" src={einstellungen.heroBild} alt="" width="1920" height="1080" fetchpriority="high" />
      {
        heroDatei ? (
          <video class="hero__video hero__datei" data-hero-datei src={heroDatei} poster={einstellungen.heroBild} muted loop playsinline preload="none" />
        ) : (
          <div class="hero__video" data-hero-video data-src={heroSrc} />
        )
      }
      <div class="hero__toenung"></div>
    </div>

    <div class="hero__leiste">
      <img class="hero__logo" src="/images/logos/gruendungslogo.webp" alt="Gründungslogo INFERNO Osnabrück Ultra' Jugend" width="96" height="96" />
      <button class="hero__menue" type="button" data-menue-auf aria-haspopup="dialog">
        <Icon name="menu" />
        <span>Menü</span>
      </button>
    </div>

    <div class="hero__inhalt">
      <h1 class="hero__titel" id="hero-titel">
        <span class="hero__zeile hero__zeile--1">Inferno</span>
        <span class="hero__zeile hero__zeile--2">Osnabrück</span>
      </h1>
      <p class="spruchband hero__spruch">{einstellungen.heroSpruch}</p>
      <div class="hero__aktionen">
        <button class="aktion" type="button" data-trailer-auf>
          <Icon name="volume-2" />
          Trailer mit Ton
        </button>
        <a class="aktion aktion--hohl" href="/spieltagsbilder/">
          <Icon name="images" />
          Spieltagsbilder
        </a>
      </div>
    </div>

    <a class="hero__runter" href="#letzter-spieltag" aria-label="Weiter nach unten">
      <Icon name="chevron-down" />
    </a>
    <div class="hero__marke" data-hero-ende></div>
  </section>

  <dialog class="trailer-dialog" data-trailer aria-label={heroVideo.titel}>
    <button class="trailer-dialog__zu" type="button" data-trailer-zu aria-label="Trailer schließen"><Icon name="x" /></button>
    <div class="trailer-dialog__rahmen" data-trailer-rahmen data-src={trailerSrc} data-titel={heroVideo.titel} data-datei={heroDatei ? 'ja' : undefined}></div>
    <p class="trailer-dialog__titel">{heroVideo.titel}</p>
  </dialog>

  <Laufband variante="weiss" />

  <!-- ============ Letzter Spieltag ============ -->
  {
    letzter && (
      <section class="kurve kurve--lila bild-choreo letzter" id="letzter-spieltag" aria-labelledby="letzter-titel">
        <div class="wrap">
          <div class="letzter__kopf">
            <h2 id="letzter-titel">Letzter Spieltag</h2>
            <p class="spruchband letzter__band">{letzter.data.titel}</p>
          </div>
          <div class="mosaik" data-galerie={letzter.data.titel}>
            {letzter.data.bilder.map((src, i) => (
              <a href={src} data-bild class:list={['mosaik__bild', { 'mosaik__bild--gross': i === 0, 'mosaik__bild--mehr': i > 4 }]}>
                <img
                  src={i === 0 ? src : thumb(src)}
                  alt={`Bild ${i + 1} vom ${letzter.data.titel}`}
                  loading="lazy"
                  decoding="async"
                  width="1600"
                  height="1067"
                />
              </a>
            ))}
          </div>
          <div class="letzter__fuss">
            <a class="aktion" href={galerieUrl(letzter)}>
              Alle {letzter.data.bilder.length} Bilder
              <Icon name="arrow-right" />
            </a>
            <a class="mehr" href={`/spieltagsbilder/${saisonListe.find((s) => s.saison === letzter.data.saison)?.slug}/`}>
              Saison {saisonLang(letzter.data.saison)}
              <Icon name="arrow-right" />
            </a>
          </div>
        </div>
      </section>
    )
  }

  <!-- ============ Aktuelles ============ -->
  <section class="kurve kurve--nacht bild-glut aktuelles" aria-labelledby="aktuelles-titel">
    <div class="wrap">
      <div class="kopf">
        <h2 id="aktuelles-titel">Aktuelles</h2>
        <p>Statements und Events des INFERNO.</p>
      </div>
      {
        beitraege.length ? (
          <ol class="beitraege">
            {beitraege.map((b) => {
              const t = b.data.termin ? termin(b.data.termin) : null;
              return (
                <li class:list={['beitrag', `beitrag--${b.data.typ.toLowerCase()}`]}>
                  <div class="beitrag__marke">
                    {t ? (
                      <time datetime={b.data.termin!.toISOString()} class="beitrag__termin">
                        <span class="beitrag__tag">{t.tag}</span>
                        <span class="beitrag__monat">{t.monat}</span>
                      </time>
                    ) : (
                      <span class="beitrag__stempel">Statement</span>
                    )}
                  </div>
                  <div class="beitrag__text">
                    <p class="beitrag__meta">
                      {b.data.typ} · <time datetime={b.data.datum.toISOString()}>{datum(b.data.datum)}</time>
                      {b.data.beispiel && <span class="beitrag__beispiel">Beispiel</span>}
                    </p>
                    <h3>
                      <a href={`/aktuelles/${b.id}/`}>{b.data.titel}</a>
                    </h3>
                    {t && (
                      <p class="beitrag__wo">
                        <Icon name="calendar" /> {t.zeit}
                        {b.data.ort && (
                          <>
                            <Icon name="map-pin" /> {b.data.ort}
                          </>
                        )}
                      </p>
                    )}
                    <p class="beitrag__anriss">{anriss(vorschau(b.body ?? ''), 60)}</p>
                  </div>
                </li>
              );
            })}
          </ol>
        ) : (
          <p class="leer">Gerade gibt es keine neuen Statements oder Events.</p>
        )
      }
      <a class="mehr" href="/aktuelles/">Alle Beiträge <Icon name="arrow-right" /></a>
    </div>
  </section>

  <!-- ============ Spieltagsbilder ============ -->
  <section class="kurve kurve--weiss bild-fahnen saisons" aria-labelledby="saisons-titel">
    <div class="wrap">
      <div class="kopf">
        <h2 id="saisons-titel">Spieltagsbilder</h2>
        <p>{zahl.format(galerienGesamt)} Galerien mit {zahl.format(bilderGesamt)} Bildern, Heim und Auswärts, seit der Saison 2016/17.</p>
      </div>
      <SaisonWand saisons={saisonListe} />
    </div>
  </section>

  <Laufband variante="lila" richtung="rechts" text="Egal wann, egal wo, egal wie!" />

  <!-- ============ Wer wir sind ============ -->
  <section class="kurve kurve--lila bild-block wir" aria-labelledby="wir-titel">
    <div class="wrap wir__raster">
      <div class="wir__text">
        <h2 id="wir-titel">{werWirSind.data.titel}</h2>
        <p class="wir__lead">{werWirSind.data.teaser}</p>
        <a class="aktion" href="/geschichte/wer-wir-sind/">Weiterlesen <Icon name="arrow-right" /></a>
      </div>
      <figure class="wir__foto">
        <img src={werWirSind.data.bild} alt={werWirSind.data.bildAlt} loading="lazy" decoding="async" width="550" height="367" />
      </figure>
    </div>
  </section>

  <!-- ============ Gruppenlogos ============ -->
  <section class="kurve kurve--nacht bild-zaun logos" aria-labelledby="logos-titel">
    <div class="wrap logos__raster">
      <div class="logos__text">
        <h2 id="logos-titel">{logos.data.titel}</h2>
        <p class="spruchband logos__band">{logos.data.untertitel}</p>
        <p class="logos__teaser">{logos.data.teaser}</p>
        <a class="aktion" href="/geschichte/gruppenlogos/">Weiterlesen <Icon name="arrow-right" /></a>
      </div>
      <ul class="aufkleber" aria-label="Unsere Gruppenlogos">
        <li class="aufkleber__eins">
          <img src="/images/logos/gruendungslogo.webp" alt="Gründungslogo: Osnabrücker Rad im lila Ring, INFERNO OSNABRÜCK · ULTRA' JUGEND" loading="lazy" width="900" height="900" />
          <span>Gründungslogo</span>
        </li>
        <li class="aufkleber__zwei">
          <img src="/images/logos/fuenf-jahres-emblem.webp" alt="Fünf-Jahres-Emblem: Mann mit Bierkrug im Lorbeerkranz" loading="lazy" width="900" height="873" />
          <span>Fünf-Jahres-Emblem</span>
        </li>
        <li class="aufkleber__drei">
          <img src="/images/logos/arminius.webp" alt="Zweites Gruppenlogo: Arminius im Lorbeerkranz" loading="lazy" width="150" height="146" />
          <span>Arminius</span>
        </li>
      </ul>
    </div>
  </section>

  <!-- ============ Geschichte ============ -->
  <section class="kurve kurve--weiss bild-pyro geschichte" aria-labelledby="geschichte-titel">
    <div class="wrap">
      <div class="geschichte__kopf">
        <div class="kopf">
          <h2 id="geschichte-titel">Geschichte</h2>
        </div>
        <img
          class="geschichte__bild"
          src="/images/geschichte/15-jahre-unruhestifter.webp"
          alt="Zeichnung: Arminius und ein Biertrinker stoßen an, Banner „15 Jahre INFERNO – 15 Jahre UnruhestIFter!“"
          loading="lazy"
          width="950"
          height="466"
        />
      </div>
      <ol class="zeitleiste">
        {
          stationen.map((s) => (
            <li class:list={['station', { 'station--offen': s.data.entwurf }]}>
              <a href={`/geschichte/${s.id}/`}>
                <span class="station__jahr">{s.data.jahr}</span>
                <Rad class="station__rad" />
                <span class="station__titel">{s.data.titel}</span>
                {s.data.untertitel && <span class="station__unter">{s.data.untertitel}</span>}
                <span class="station__text">{s.data.entwurf ? 'Text folgt.' : anriss(s.data.teaser)}</span>
              </a>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- ============ Trailer ============ -->
  <section class="kurve kurve--nacht bild-rauch trailer" aria-labelledby="trailer-titel">
    <div class="wrap">
      <div class="kopf">
        <h2 id="trailer-titel">Trailer</h2>
        <p>{(seite('verschwende-deine-jugend').body ?? '').match(/Zusätzlich wurden[^*]*/)?.[0].trim()}</p>
      </div>
      <div class="trailer__raster">
        {
          videos.map((v, i) => (
            <VideoEmbed
              class={i === 0 ? 'trailer__haupt' : ''}
              gross={i === 0}
              titel={v.data.titel}
              anbieter={v.data.anbieter}
              videoId={v.data.videoId}
              poster={v.data.poster}
              dauer={v.data.dauer}
            />
          ))
        }
      </div>
    </div>
  </section>

  <!-- ============ Links ============ -->
  <section class="kurve kurve--weiss bild-fahnen links" aria-labelledby="links-titel">
    <div class="wrap">
      <h2 id="links-titel">Links</h2>
      {
        links.gruppen.map((g) => (
          <div class="linkgruppe">
            <h3>{g.name}</h3>
            <ul>
              {g.links.map((l) => (
                <li>
                  <a href={l.url} target="_blank" rel="noopener noreferrer">
                    <img src={l.logo} alt="" loading="lazy" />
                    <span>
                      {l.name} <Icon name="external-link" />
                    </span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </section>

  <!-- ============ Kontakt ============ -->
  <section class="kurve kurve--lila bild-zaun kontakt" aria-labelledby="kontakt-titel">
    <div class="wrap kontakt__raster">
      <div>
        <h2 id="kontakt-titel">Kontakt</h2>
        <p class="kontakt__text">{vorschau(kontakt.body ?? '').replace(/\s*In der Kurve!\s*$/, '')}</p>
        <p class="spruchband kontakt__band">In der Kurve!</p>
      </div>
      <div class="kontakt__ende">
        <a class="aktion" href="/kontakt/"><Icon name="send" /> Zum Kontaktboard</a>
        <a class="mehr" href="mailto:info@inferno-os.de"><Icon name="mail" /> info@inferno-os.de</a>
      </div>
    </div>
  </section>
</Base>

<style>
  /* ---------- Hero ---------- */
  .hero {
    position: relative;
    min-height: 100svh;
    display: grid;
    grid-template-rows: auto 1fr auto;
    overflow: hidden;
    isolation: isolate;
    background: var(--nacht);
  }
  .hero__medien,
  .hero__poster,
  .hero__video,
  .hero__toenung {
    position: absolute;
    inset: 0;
  }
  .hero__medien {
    z-index: -1;
  }
  .hero__poster {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .hero__video {
    overflow: hidden;
    opacity: 0;
    transition: opacity 1.2s var(--ease-out);
  }
  .hero__video.laeuft {
    opacity: 1;
  }
  .hero__datei {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .hero__video :global(iframe) {
    position: absolute;
    top: 50%;
    left: 50%;
    width: max(100%, 177.78svh);
    height: max(100%, 56.25vw);
    translate: -50% -50%;
    border: 0;
    pointer-events: none;
  }
  .hero__toenung {
    background:
      linear-gradient(to top, rgb(10 8 11 / 0.88) 0%, rgb(10 8 11 / 0.3) 42%, rgb(10 8 11 / 0) 68%, rgb(10 8 11 / 0.45) 100%),
      rgb(92 29 104 / 0.3);
    mix-blend-mode: normal;
  }
  .hero__toenung::after {
    content: '';
    position: absolute;
    inset: 0;
    background: url('/images/korn.png') 0 0 / 180px;
    opacity: 0.22;
    mix-blend-mode: overlay;
  }

  .hero__leiste {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: clamp(1rem, 3vw, 2rem) var(--rand) 0;
  }
  .hero__logo {
    width: clamp(4rem, 8vw, 6rem);
    height: auto;
    border-radius: 50%;
    box-shadow: 0 0 0 4px rgb(255 255 255 / 0.15);
  }
  .hero__menue {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.75rem;
    padding: 0.45rem 1rem 0.35rem;
    border: 2px solid var(--weiss);
    background: rgb(10 8 11 / 0.25);
    color: var(--weiss);
    font-family: var(--display);
    text-transform: uppercase;
    font-size: 1.15rem;
    cursor: pointer;
  }
  .hero__menue :global(svg) {
    width: 1.3rem;
    height: 1.3rem;
  }
  .hero__menue:hover {
    background: var(--weiss);
    color: var(--lila);
  }

  .hero__inhalt {
    align-self: end;
    padding: 0 var(--rand) clamp(5rem, 11vh, 8rem);
    display: grid;
    justify-items: start;
    gap: clamp(1.2rem, 3vh, 2rem);
  }
  .hero__titel {
    display: grid;
    line-height: 0.82;
    letter-spacing: -0.01em;
    text-shadow: 0 0.4rem 2.5rem rgb(10 8 11 / 0.6);
  }
  .hero__zeile--1 {
    font-size: clamp(4.4rem, 17.5vw, 15.5rem);
  }
  .hero__zeile--2 {
    font-size: clamp(3.1rem, 12.6vw, 11.2rem);
    color: var(--lila-licht);
  }
  .hero__spruch {
    font-size: clamp(1.45rem, 0.9rem + 2.6vw, 3.2rem);
    margin: 0;
    padding: 0.2em 0.6em 0.14em;
  }
  .hero__aktionen {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
  }
  .hero__runter {
    position: absolute;
    left: 50%;
    bottom: 1.2rem;
    translate: -50% 0;
    color: var(--weiss);
    animation: wippe 2.4s var(--ease-out) infinite;
  }
  .hero__runter :global(svg) {
    width: 2rem;
    height: 2rem;
  }
  @keyframes wippe {
    50% {
      transform: translateY(6px);
    }
  }
  .hero__marke {
    position: absolute;
    top: 45%;
    height: 1px;
    width: 1px;
  }

  /* Der eine Auftritt: Name kommt aus dem Rauch, Spruchband schwingt ein */
  @media (prefers-reduced-motion: no-preference) {
    .hero__zeile {
      animation: aus-dem-rauch 1.6s var(--ease-out) both;
    }
    .hero__zeile--2 {
      animation-delay: 0.18s;
    }
    .hero__spruch {
      animation: einschwingen 1.3s var(--ease-out) 0.55s both;
      transform-origin: 0 50%;
    }
    .hero__aktionen {
      animation: auftauchen 1s var(--ease-out) 0.9s both;
    }
  }
  @keyframes aus-dem-rauch {
    from {
      opacity: 0.15;
      filter: blur(14px);
      transform: translateY(0.12em) scale(1.04);
      letter-spacing: 0.06em;
    }
  }
  @keyframes einschwingen {
    from {
      opacity: 0;
      transform: rotate(-9deg) translateX(-1.5rem);
    }
  }
  @keyframes auftauchen {
    from {
      opacity: 0;
      transform: translateY(0.75rem);
    }
  }

  /* Trailer mit Ton */
  .trailer-dialog {
    width: min(100% - 2rem, 76rem);
    max-width: none;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--weiss);
    overflow: visible;
  }
  .trailer-dialog::backdrop {
    background: rgb(10 8 11 / 0.92);
  }
  .trailer-dialog__rahmen {
    aspect-ratio: 16 / 9;
    background: var(--nacht);
    box-shadow: 0 2rem 4rem -1.5rem rgb(0 0 0 / 0.8);
  }
  .trailer-dialog__rahmen :global(iframe),
  .trailer-dialog__rahmen :global(video) {
    width: 100%;
    height: 100%;
    border: 0;
  }
  .trailer-dialog__titel {
    margin: 1rem 0 0;
    font-family: var(--display);
    text-transform: uppercase;
    font-size: 1.3rem;
  }
  .trailer-dialog__zu {
    position: absolute;
    right: 0;
    bottom: calc(100% + 0.75rem);
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border: 2px solid var(--weiss);
    border-radius: 50%;
    background: transparent;
    color: var(--weiss);
    cursor: pointer;
  }
  .trailer-dialog__zu:hover {
    background: var(--weiss);
    color: var(--lila);
  }
  .trailer-dialog__zu :global(svg) {
    width: 1.4rem;
    height: 1.4rem;
  }

  /* ---------- Letzter Spieltag ---------- */
  .letzter__kopf {
    display: grid;
    gap: 1.2rem;
    justify-items: start;
    margin-bottom: clamp(2rem, 4vw, 3rem);
  }
  .letzter__band {
    font-size: clamp(1.05rem, 0.8rem + 1.2vw, 1.75rem);
    margin: 0;
    max-width: 100%;
  }
  .mosaik {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    grid-auto-rows: clamp(7rem, 13vw, 12rem);
    gap: clamp(0.4rem, 1vw, 0.8rem);
  }
  .mosaik__bild {
    position: relative;
    overflow: hidden;
    background: var(--lila-tief);
  }
  .mosaik__bild--gross {
    grid-column: span 2;
    grid-row: span 2;
  }
  .mosaik__bild--mehr {
    display: none;
  }
  .mosaik__bild img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition:
      transform 0.9s var(--ease-out),
      filter 0.5s var(--ease-out);
  }
  .mosaik__bild:hover img {
    transform: scale(1.05);
    filter: saturate(1.2) contrast(1.05);
  }
  .letzter__fuss {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 2rem;
