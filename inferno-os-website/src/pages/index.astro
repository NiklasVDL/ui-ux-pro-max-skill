</style>

<script>
  // Hintergrund-Trailer: nur laden, wenn Bewegung erwünscht ist und kein Datensparmodus aktiv ist
  const huelle = document.querySelector<HTMLElement>('[data-hero-video]');
  const sparen = (navigator as Navigator & { connection?: { saveData?: boolean } }).connection?.saveData;
  const ruhig = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (huelle && !sparen && !ruhig) {
    const frame = document.createElement('iframe');
    frame.src = huelle.dataset.src!;
    frame.title = 'Trailer im Hintergrund';
    frame.allow = 'autoplay; fullscreen';
    frame.tabIndex = -1;
    frame.setAttribute('aria-hidden', 'true');
    frame.referrerPolicy = 'strict-origin-when-cross-origin';
    const zeigen = () => huelle.classList.add('laeuft');
    if (frame.src.startsWith('https://player.vimeo.com/')) {
      // Erst einblenden, wenn Vimeo wirklich abspielt; bis dahin bleibt das Kurvenbild stehen.
      window.addEventListener('message', (e) => {
        if (e.origin !== 'https://player.vimeo.com' || e.source !== frame.contentWindow) return;
        let daten: { event?: string } = {};
        try {
          daten = typeof e.data === 'string' ? JSON.parse(e.data) : e.data;
        } catch {
          return;
        }
        if (daten.event === 'ready') {
          frame.contentWindow?.postMessage(JSON.stringify({ method: 'addEventListener', value: 'playProgress' }), 'https://player.vimeo.com');
        }
        if (daten.event === 'playProgress') zeigen();
      });
    } else {
      frame.addEventListener('load', () => setTimeout(zeigen, 1200));
    }
    huelle.append(frame);
  }

  // Eigene Videodatei statt Vimeo/YouTube
  const datei = document.querySelector<HTMLVideoElement>('[data-hero-datei]');
  if (datei && !sparen && !ruhig) {
    datei.addEventListener('playing', () => datei.classList.add('laeuft'), { once: true });
    datei.play().catch(() => {});
  }

  // Trailer mit Ton im Dialog
  const dialog = document.querySelector<HTMLDialogElement>('[data-trailer]');
  const rahmen = document.querySelector<HTMLElement>('[data-trailer-rahmen]');
  document.querySelector('[data-trailer-auf]')?.addEventListener('click', () => {
    if (!dialog || !rahmen) return;
    if (rahmen.dataset.datei) {
      const video = document.createElement('video');
      video.src = rahmen.dataset.src!;
      video.controls = true;
      video.autoplay = true;
      video.playsInline = true;
      rahmen.replaceChildren(video);
      dialog.showModal();
      return;
    }
    const frame = document.createElement('iframe');
    frame.src = rahmen.dataset.src!;
    frame.title = rahmen.dataset.titel ?? 'Trailer';
    frame.allow = 'autoplay; fullscreen; picture-in-picture';
    frame.allowFullscreen = true;
    frame.referrerPolicy = 'strict-origin-when-cross-origin';
    rahmen.replaceChildren(frame);
    dialog.showModal();
  });
  document.querySelector('[data-trailer-zu]')?.addEventListener('click', () => dialog?.close());
  dialog?.addEventListener('click', (e) => {
    if (e.target === dialog) dialog.close();
  });
  dialog?.addEventListener('close', () => rahmen?.replaceChildren());
</script>
